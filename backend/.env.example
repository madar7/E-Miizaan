PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=
CLIENT_URL=http://localhost:3000

# Optional — leave blank to print reset links to the console instead of emailing
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
