# Copy this file to .env and fill in real values before running the server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/e_miizaan
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# The frontend's origin, for CORS. Leave blank during local development to
# allow any origin; set it to your real frontend URL in production
# (e.g. https://e-miizaan.netlify.app) to restrict access to just that site.
FRONTEND_ORIGIN=

# Base URL of the FRONTEND (not this API) — used to build the link inside
# password-reset emails. Point this at wherever frontend/ is being served.
CLIENT_URL=http://localhost:3000

# SMTP settings for sending password-reset emails.
# If left blank, the reset link is just printed to the server console instead —
# handy for local development, but you'll want real SMTP values in production.
# Example with a Gmail app password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Miizaan <no-reply@e-miizaan.local>"
